{
  "name": "babble",
  "version": "0.1.0",
  "private": true,
  "description": "Babble - 基于 Cloudflare Workers 的 memos 复刻后端 API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "./scripts/deploy/deploy.sh",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply babble --local"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.5.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "sql.js": "^1.14.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.121.0"
  }
}
